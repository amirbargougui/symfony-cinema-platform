<form method="post" action="{{ path('app_sieges_delete', {'siegeid': siege.siegeid}) }}" onsubmit="return confirm('Are you sure you want to delete this item?');">
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ siege.siegeid) }}">
    <button type="submit" class="btn btn-danger">Delete</button>
</form>
