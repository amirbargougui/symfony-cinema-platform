{% extends 'base.html.twig' %}

{% block title %}Supprimer Réservation {{ reservation.reservationid }}{% endblock %}

{% block body %}
    <h1>Supprimer Réservation {{ reservation.reservationid }}</h1>

    <p>Voulez-vous vraiment supprimer cette réservation ?</p>

    <form action="{{ path('admin_reservations_delete', {'id': reservation.reservationid}) }}" method="post">
        {{ csrf_token('delete' ~ reservation.reservationid) }}
        <button type="submit" class="btn btn-danger">Oui, supprimer</button>
        <a href="{{ path('admin_reservations_index') }}" class="btn btn-secondary">Annuler</a>
    </form>
{% endblock %}
