{% extends 'base.html.twig' %}

{% block title %}Modifier Réservation{{ reservation.Reservationid }}{% endblock %}

{% block body %}
    <h1>Modifier Réservation {{ reservation.Reservationid }}</h1>

    <form method="post">
        {{ form_start(form) }}
        {{ form_widget(form) }}

        <button type="submit" class="btn btn-primary">Enregistrer les modifications</button>
        <a href="{{ path('admin_reservations_index') }}" class="btn btn-secondary">Annuler</a>
        {{ form_end(form) }}
    </form>
{% endblock %}
