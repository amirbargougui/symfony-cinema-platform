{% extends 'base.html.twig' %}

{% block title %}Reservations{% endblock %}

{% block body %}
    <h1>Reservations</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>Reservationid</th>
                <td>{{ reservation.reservationid }}</td>
            </tr>
            <tr>
                <th>Filmid</th>
                <td>{{ reservation.filmid }}</td>
            </tr>
            <tr>
                <th>Datereservation</th>
                <td>{{ reservation.datereservation ? reservation.datereservation|date('Y-m-d') : '' }}</td>
            </tr>
            <tr>
                <th>Heurereservation</th>
                <td>{{ reservation.heurereservation ? reservation.heurereservation|date('H:i:s') : '' }}</td>
            </tr>
            <tr>
                <th>Nombreplacesreservees</th>
                <td>{{ reservation.nombreplacesreservees }}</td>
            </tr>
            <tr>
                <th>Nombreplacesdisponibles</th>
                <td>{{ reservation.nombreplacesdisponibles }}</td>
            </tr>
        </tbody>
    </table>

    <a href="{{ path('app_reservationss_index') }}">back to list</a>

    <a href="{{ path('app_reservationss_edit', {'reservationid': reservation.reservationid}) }}">edit</a>

    {{ include('reservationss/_delete_form.html.twig') }}
{% endblock %}
