{% extends 'base.html.twig' %}

{% block title %}Categories index{% endblock %}

{% block body %}
    <h1>Categories index</h1>

    <table class="table">
        <thead>
            <tr>
                <th>Categorieid</th>
                <th>Nomcategorie</th>
                <th>Descriptioncategorie</th>
                <th>actions</th>
            </tr>
        </thead>
        <tbody>
        {% for category in categories %}
            <tr>
                <td>{{ category.categorieid }}</td>
                <td>{{ category.nomcategorie }}</td>
                <td>{{ category.descriptioncategorie }}</td>
                <td>
                    <a href="{{ path('app_categories_edit', {'categorieid': category.categorieid}) }}">Edit</a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="4">no records found</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    <a href="{{ path('app_categories_new') }}">Create new</a>
{% endblock %}
