{% extends 'base.html.twig' %}

{% block title %}Edit Category{% endblock %}

{% block body %}
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-md-8">
                <div class="card">
                    <div class="card-header">
                        <h3 class="card-title">Edit Category</h3>
                    </div>
                    <div class="card-body">
                        <div class="row">
                            <div class="col-md-6">
                                {{ include('categories/_form.html.twig', {'button_label': 'Update'}) }}
                                {{ include('categories/_delete_form.html.twig') }}
                            </div>
                        </div>
                    </div>
                </div>
                <a href="{{ path('app_categories_index') }}" class="btn btn-secondary mt-3">Back to List</a>
            </div>
        </div>
    </div>
{% endblock %}
